{
  "name": "@autional/consent-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/gen-env.mjs && vite --port 13113",
    "build": "node ../../scripts/gen-env.mjs && tsc && vite build",
    "prebuild": "node ../../scripts/check-pwa-config.mjs",
    "preview": "vite preview --port 13113",
    "lint:a11y": "eslint -c eslint.a11y.config.mjs --max-warnings 0 \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router": "7.15.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.4.0",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "29.1.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.0",
    "vite": "6.4.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1"
  }
}
